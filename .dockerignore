# Keep the image small and, above all, keep local secrets out of it:
# app/config.py loads ../../.env if one exists, so a copied .env would win.
.env
.env.*
!.env.example
.git
.claude
claude-reports
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
web/dist
web/test-results
web/playwright-report
extension/dist
extension/dist-test
extension/test-results
extension/playwright-report
extension/*.zip
cloudflare/.wrangler
**/.DS_Store
