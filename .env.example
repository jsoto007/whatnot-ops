# Copy to .env. Local only — the API refuses to start without DATABASE_URL and
# never falls back to a remote database.
APP_ENV=development
SECRET_KEY=dev-only-change-me
DATABASE_URL=postgresql+psycopg://localhost:5432/whatnot_ops
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/whatnot_ops_test
# Run jobs (parsing, exports) synchronously instead of in `make worker`.
JOBS_INLINE=1

# Developer support account: an owner the shop cannot demote or disable, created
# or repaired at every start (`flask ensure-support`). Set both or neither.
# IT_SUPPORT=
# IT_SUPPORT_PASSWORD=

# Email (Phase 3). Unset = emails are printed to the API log.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# EMAIL_FROM=

# AI supervisor. AI_PROVIDER = none (default) | jev | claude | fake (dev/test only).
# Keys only from env, never committed.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# JEV_API_KEY=
# JEV_API_URL=https://api.jevai.net
# JEV_MODEL=
