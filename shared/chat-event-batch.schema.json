{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-ops/shared/chat-event-batch.schema.json",
  "title": "ChatEventBatch",
  "description": "One upload from the Chat Scraper extension to POST /api/ingest. Rows are idempotent by id; re-sending a batch is safe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "show", "rows"],
  "properties": {
    "version": { "const": 1 },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Device-side show key (the ISO start time)." },
        "startedAt": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "maxLength": 512 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "showId", "username", "body", "rawText", "capturedAt", "seq"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "showId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "username": { "type": "string", "maxLength": 80 },
        "body": { "type": "string", "maxLength": 4000 },
        "rawText": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "seq": { "type": "integer", "minimum": 1 },
        "source": {
          "const": "player",
          "description": "Only on a win read from Whatnot's video player (\"<winner> won the auction for <item> for $<d.cc>\"). Absent on chat lines."
        }
      }
    }
  }
}
