{
  "manifest_version": 3,
  "name": "Chat Scraper",
  "version": "1.2.0",
  "description": "Captures Whatnot live show chat with timestamps, auto-save, watch words and built-in Chat Search.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show / hide Chat Scraper (opens Chat Search on other pages)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}