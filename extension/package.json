{
  "name": "sales-ops-extension",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:test && playwright test -c e2e/playwright.config.ts",
    "test:full": "npm run build && npm --prefix ../web run build && playwright test -c e2e/full/playwright.config.ts",
    "package": "npm run build && node package.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.30.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
